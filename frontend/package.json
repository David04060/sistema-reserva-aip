{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:express": "vite --mode express --strictPort",
    "db:init:local": "wrangler d1 execute reservas-aip-db --local --file schema.sql",
    "test:worker": "npm run build && node --test tests/worker.test.mjs",
    "dev": "vite --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint --config ../.oxlintrc.json --deny-warnings",
    "preview": "vite preview",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.2-beta",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.150.0"
  }
}
