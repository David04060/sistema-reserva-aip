{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sistema-reserva-aip",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reservas-aip-db",
      "database_id": "23367e02-f7bf-490c-a98d-cbe21876e641",
    },
  ],
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
